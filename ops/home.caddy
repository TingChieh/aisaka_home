# Install as /etc/caddy/sites.d/home.caddy.
aisaka.cc {
	encode gzip zstd
	root * /var/www/home
	file_server
}

# Exact subdomain sites take precedence over this fallback.
*.aisaka.cc {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
		resolvers 1.1.1.1 1.0.0.1
	}
	encode gzip zstd
	root * /var/www/home
	file_server
}
